# Copy to `.env.tools`. Credentials for local tooling ONLY — read by
# scripts/migrate.mjs, uploaded to nothing.
#
# Kept out of apps/api/.dev.vars deliberately. That file exists to be
# pushed to the edge, and SUPABASE_ACCESS_TOKEN can drop and recreate
# the public schema of every project on the account. A file that gets
# pushed should hold only things that should be pushed; the separation
# is what makes that true by construction rather than by remembering.
#
# ONE of these is enough. The project ref is derived from SUPABASE_URL
# in apps/api/.dev.vars, so neither needs it configured separately.

# Management API. Preferred: revocable, and never needs the database
# password. Create at supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=sbp_...

# Direct connection, run through psql. Needs psql on PATH.
# SUPABASE_DB_URL=postgresql://postgres:PASSWORD@db.<ref>.supabase.co:5432/postgres
