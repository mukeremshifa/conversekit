# Copy to .env.local to point the dashboard somewhere other than
# production. Both are optional — with no .env.local the dev server
# talks to the deployed Worker, which is usually what you want for UI
# work because the screens then render real bots, leads and transcripts.
#
# Uncomment to develop against a locally running Worker (`npm run dev`).
# Note that `wrangler dev` opens a remote session here — the AI binding
# has no local simulator — so it needs `wrangler login` first.
# VITE_API_BASE=http://localhost:8787

# Uncomment to make the Install screen's snippet and the Playground
# point at the local static server (`npm run landing`) instead of Pages.
# VITE_WIDGET_BASE=http://localhost:8788
