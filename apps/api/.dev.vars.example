# Copy to `.dev.vars` and fill in. Beside wrangler.jsonc on purpose:
# `wrangler dev` loads the .dev.vars sitting in the same directory as
# the config file, so a copy at the repo root is invisible to it.
#
# EVERY KEY IN THIS FILE IS UPLOADED TO THE EDGE by
# `npm run secrets:push`. If a credential should not run in a Worker, it
# belongs in ../../.env.tools instead — see the note there.
#
# The same five names are declared as `secrets.required` in
# wrangler.jsonc, which makes a deploy fail rather than a request 502
# when one of them was never uploaded.

# Supabase. The service-role key bypasses RLS; the Worker uses it only
# on paths that have already resolved a tenant.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Model vendors. Both are shared across every tenant, which is why the
# chat path is rate limited — see the ratelimits block in wrangler.jsonc.
GEMINI_API_KEY=
GROQ_API_KEY=

# ── One environment ───────────────────────────────────────────────
# There is no second copy of this file. This project has one Supabase
# project and one set of Workers, so the keys `wrangler dev` reads here
# are the keys `npm run secrets:push` uploads to the edge — which is
# also why `npm run dev` talks to the real database: there is no other.
