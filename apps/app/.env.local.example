# Copy to .env.local to point the dashboard somewhere other than
# production. Both are optional — with no .env.local the dev server
# talks to the deployed Worker, which is usually what you want for UI
# work because the screens then render real bots, leads and transcripts.
#
# The defaults come from config/origins.js via Vite `define`, so there
# is nothing to set here just to build.
#
# Uncomment to develop against a locally running Worker
# (`npm run dev:api`). Note that `wrangler dev` opens a remote session —
# the AI binding has no local simulator — so it needs `wrangler login`
# first.
# VITE_API_BASE=http://localhost:8787

# Uncomment to make the Install screen's snippet and the Playground load
# the widget from the local CDN server (`npm run dev:cdn`) instead of
# from cdn.conversekit.…. This is the FULL script src, not a base: the
# production value is the major-pinned /v1/widget.js path.
# VITE_WIDGET_SRC=http://localhost:8789/v1/widget.js
