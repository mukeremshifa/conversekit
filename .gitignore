node_modules/
.wrangler/

# Secrets. Two files, two audiences, and the split is the point:
#
#   apps/api/.dev.vars   runtime secrets for the ck-api Worker. Beside
#                        wrangler.jsonc because that is where `wrangler
#                        dev` looks, and everything in it is uploaded to
#                        the edge by `npm run secrets:push`. One file:
#                        there is one environment, so what runs locally
#                        and what runs on the edge read the same keys.
#   .env.tools           credentials for local tooling. Read only by
#                        scripts/migrate.mjs, uploaded nowhere.
.dev.vars*
.env.tools
*.env

# ...except the templates, which are the documentation.
!*.example

# Build output. Every one of these is produced by `npm run build` (or by
# `npm run dev`, which builds before it serves) from tracked sources, so
# a committed copy can only ever be a stale copy that outranks the real
# one.
dist/
apps/*/dist/

# tsc emits these next to their sources if it is ever run without
# --noEmit; wrangler builds from the .ts, so they are always litter.
apps/api/src/**/*.js
*.tsbuildinfo

# Scratch harnesses. scripts/build-assets.mjs also refuses to copy any
# `__*` file into a dist/, so one of these cannot reach a deploy even if
# git is somehow persuaded to track it — see the note there for the time
# a screenshot rig with seeded fake messages was served from the site
# root.
apps/*/assets/__*

# Vite local overrides (apps/app/.env.local). The `*.env` rule above
# does not match these — they end in .local, not .env.
.env.local
.env.*.local
