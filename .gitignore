node_modules/
dist/
.wrangler/
.dev.vars
*.env

# tsc emits these next to their sources if it is ever run without
# --noEmit; wrangler builds from the .ts, so they are always litter.
src/**/*.js
*.tsbuildinfo

# Scratch harnesses. Keeps them out of git; the deploy itself is guarded
# by the predeploy:pages script, because `wrangler pages deploy public`
# uploads the whole directory regardless of what git ignores — an
# uncommitted debug page reached production once that way.
public/__*

# Vite local overrides (dashboard/.env.local). The `*.env` rule above
# does not match these — they end in .local, not .env.
.env.local
.env.*.local
